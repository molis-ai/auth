{
  "name": "@molis/auth-cloudflare",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "setup": "npm --prefix worker ci && npm --prefix web ci && npm --prefix worker run setup:rust",
    "dev": "node worker/scripts/environment-command.mjs start",
    "build:web": "npm --prefix web run build",
    "check": "npm run contracts:check && npm --prefix worker run check && npm --prefix worker test",
    "test": "node --test scripts/environment-properties.test.mjs && npm run check && npm --prefix web test",
    "build": "npm run build:web && npm --prefix worker run build",
    "format": "npm --prefix worker run format",
    "format:check": "npm --prefix worker run format:check",
    "clippy": "npm --prefix worker run clippy",
    "admin": "npm --prefix worker run admin",
    "contracts:generate": "node contracts/unified-account/generate.ts",
    "contracts:check": "node contracts/unified-account/generate.ts --check && node --test contracts/unified-account/validate.test.ts && node --test contracts/unified-account/verify-product.test.mjs",
    "test:browser": "node web/scripts/v2-browser.test.mjs",
    "test:browser:billing": "node web/scripts/billing-browser.test.mjs",
    "start": "node worker/scripts/environment-command.mjs start",
    "deploy": "node worker/scripts/environment-command.mjs deploy"
  }
}
