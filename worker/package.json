{
  "name": "@molis/auth-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "format": "prettier --write src tests scripts *.json *.jsonc migrations/*.sql --ignore-unknown",
    "format:check": "prettier --check src tests scripts *.json *.jsonc --ignore-unknown",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate": "wrangler d1 migrations apply auth-local --local",
    "db:seed": "wrangler d1 execute auth-local --local --file local-seed.sql",
    "admin": "node scripts/local-admin.ts",
    "test:e2e": "node scripts/e2e.ts",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:password": "node scripts/password-benchmark.ts",
    "test:smoke": "node scripts/smoke.ts",
    "build": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  },
  "dependencies": {
    "jose": "6.2.12",
    "pngjs": "7.0.0"
  }
}
