{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "molis-auth-preview",
  "main": "../../rust/build/index.js",
  "build": { "command": "node scripts/rust-build.mjs" },
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "AUTH_ORIGIN": "https://auth-preview.adeptify.me",
    "PLATFORM_ADMIN_IDS": ""
  },
  "routes": [
    {
      "pattern": "auth-preview.adeptify.me",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "molis-auth-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_KDF", "class_name": "PasswordKdf" }]
  },
  "migrations": [{ "tag": "password-kdf-v1", "new_sqlite_classes": ["PasswordKdf"] }]
}
