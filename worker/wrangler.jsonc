{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "molis-auth-local",
  "main": "rust/build/index.js",
  "build": {
    "command": "node scripts/rust-build.mjs",
    "watch_dir": ["rust/src", "rust/Cargo.toml", "rust/Cargo.lock"],
  },
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "vars": {
    "AUTH_ORIGIN": "http://127.0.0.1:8787",
    "AUTH_WEB_CLIENT_ID": "molis-auth-web-local",
    "UNIFIED_ACCOUNT_CONFIG": "{\"environmentId\":\"unified-local\",\"kind\":\"LOCAL\",\"authOrigin\":\"http://127.0.0.1:8787\",\"deliveryMode\":\"MOCK\",\"providerMode\":\"MOCK\"}",
    "TENANT_CREATION_POLICY": "SELF_SERVICE",
  },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auth-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "PASSWORD_KDF", "class_name": "PasswordKdf" }] },
  "migrations": [{ "tag": "password-kdf-v1", "new_sqlite_classes": ["PasswordKdf"] }],
}
